.wrap{width:98%;}
.options_wrap h2{font-size:28px;font-style:normal;margin-bottom:20px;}
.options_wrap{float:left;height:auto;line-height:1.5em;width:750px;}
.section_wrap{float:left;margin-bottom:20px;width:750px;}
.section_body{-moz-border-radius:0 0 6px 6px;background:#f9f9f9;border:1px solid #ddd;border-top:0;float:left;width:748px;}
h3.section_title{-moz-border-radius:6px;background:#F1F1F1;border:1px solid #DDD;clear:both;color:#4E4C41;cursor:pointer;font-size:1.2em;margin:0;padding:15px 15px 15px 40px;}
h3.section_title:hover{background-color:#F2f2f2;border:1px solid #CFCFCF;}
h3.open{-moz-border-radius:6px 6px 0 0;}
h3.section_title span{color:#AAA;float:right;font-size:.9em;font-weight:400;}
.options_input{clear:both;margin:15px 20px;overflow:hidden;padding:10px;}
.options_desc{-moz-border-radius:8px;background:none repeat scroll 0 0 #F1F1F1;color:#777;float:right;padding:15px;width:350px;}
.labels{color:#555;display:block;font-size:12px;font-weight:700;margin-bottom:5px;}
label{color:#555;font-size:12px;font-weight:700;margin-bottom:5px;}
.options_input input[type="text"],.options_input select{background:#FFF;border-color:#DFDFDF;color:#666;font-size:12px;padding:5px;width:275px;}
.options_input input:focus,.options_input textarea:focus{background:#fff;}
.options_input textarea{background:#FFF;border-color:#DFDFDF;color:#666;height:135px;padding:5px;width:275px;}
span.submit{float:left;margin:0 30px 30px 0;padding:0;width:15%;}
.section_wrap span.submit{float:left;margin:0 20px 30px 30px;padding:0;width:15%;}
.section_wrap .options_desc select{ height:auto }
.labels.full{ width: 25%; float:left; line-height:30px;}
input.full, textarea.full{ width: 70% !important; }
.line-break{ margin:0 20px;border:1px dashed #ccc }